{
  "name": "agenttrail",
  "version": "0.7.0",
  "description": "AgentTrail: an auditable local AI agent layer for Ollama and local models, with search, diff-safe edits, receipts, replay, memory, MCP, and reports.",
  "main": "server.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mughal-Baig/local-ai-agent.git"
  },
  "homepage": "https://github.com/Mughal-Baig/local-ai-agent#readme",
  "bugs": {
    "url": "https://github.com/Mughal-Baig/local-ai-agent/issues"
  },
  "bin": {
    "agenttrail": "bin/agenttrail.js",
    "agenttrail-chat": "bin/agenttrail-chat.js"
  },
  "files": [
    "bin",
    "desktop",
    "docs/*.md",
    "docs/*.html",
    "docs/*.gif",
    "docs/*.png",
    "docs/*.svg",
    "docs/demo-video",
    "docs/mcp",
    "docs/openapi",
    "docs/quality",
    "docs/site",
    "docs/video-walkthroughs",
    "docs/launch",
    "docs/community",
    "docs/showcase",
    "docs/benchmarks",
    "docs/sbom",
    "docs/screenshots",
    "marketplace",
    "mcp",
    "migrations",
    "plugins",
    "profiles",
    "team",
    "public",
    "recipe-packs",
    "recipes",
    "scripts",
    "src",
    "tests",
    "installers/macos",
    "installers/windows",
    "installers/linux/AgentTrail-Linux-readme.txt",
    "installers/linux/AppRun",
    "installers/linux/agenttrail.appdata.xml",
    "installers/linux/agenttrail.spec",
    "installers/linux/debian",
    "workspace/welcome.md",
    "Dockerfile",
    "install.sh",
    "server.js",
    "README.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "GOVERNANCE.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/smoke-test.js",
    "test:unit": "node tests/unit/foundation.test.js",
    "test:hardware": "node tests/unit/runtime-hardware.test.js",
    "test:loading": "node tests/unit/runtime-loading.test.js",
    "test:registry": "node tests/unit/model-registry.test.js && node tests/integration/model-registry.test.js",
    "test:ecosystem": "node tests/unit/model-ecosystem.test.js && node tests/integration/model-ecosystem.test.js",
    "test:advanced": "node tests/unit/advanced-agent.test.js && node tests/integration/advanced-agent.test.js",
    "test:desktop": "node tests/unit/desktop-distribution.test.js",
    "test:supply-chain": "node tests/unit/supply-chain.test.js",
    "test:security-privacy": "node tests/unit/security-privacy.test.js && node tests/integration/threat-model.test.js",
    "test:privacy-controls": "node tests/integration/privacy-controls.test.js",
    "test:observability": "node tests/unit/observability.test.js && node tests/integration/observability.test.js",
    "test:team": "node tests/unit/team-enterprise.test.js && node tests/integration/team-enterprise.test.js",
    "test:quality": "node tests/unit/quality-engineering.test.js && node tests/unit/workspace-safety-fuzz.test.js",
    "test:docs": "node scripts/generate-api-reference.js --check && node scripts/generate-docs-site.js --check && node tests/unit/docs.test.js",
    "test:community": "node scripts/generate-docs-site.js --check && node tests/unit/community-growth.test.js",
    "test:fuzz": "node tests/unit/workspace-safety-fuzz.test.js",
    "coverage": "node scripts/coverage-report.js",
    "test:conv-export": "node tests/integration/conversation-export.test.js",
    "test:redact-api": "node tests/integration/redact.test.js",
    "test:redact": "node tests/unit/redact.test.js",
    "test:documents": "node tests/unit/pdf-extraction.test.js",
    "test:audio": "node tests/unit/audio-transcription.test.js && node tests/integration/audio-transcription.test.js",
    "test:images": "node tests/unit/image-generation.test.js && node tests/integration/image-generation.test.js",
    "test:vision": "node tests/integration/vision-input.test.js",
    "test:search": "node tests/unit/search-chunking.test.js",
    "test:integration": "node tests/integration/api.test.js",
    "test:backend": "node tests/integration/openai-backend.test.js",
    "test:v1": "node tests/integration/openai-compatible-server.test.js",
    "test:models": "node tests/integration/model-management.test.js",
    "test:cli": "node tests/integration/cli.test.js",
    "test:embed-cache": "node tests/integration/embedding-cache.test.js",
    "eval:search": "node scripts/eval-search.js",
    "bench:search": "node scripts/benchmark-search.js",
    "bench:quality": "node scripts/performance-regression.js",
    "bench:runtime": "node scripts/benchmark-runtime.js",
    "test:rerank": "node tests/unit/rerank.test.js",
    "test:resume": "node tests/integration/resumable-run.test.js",
    "test:reindex": "node tests/integration/search-incremental.test.js",
    "test:health": "node tests/integration/health.test.js",
    "test:resilience": "node tests/unit/resilience.test.js && node tests/integration/resilience.test.js",
    "test:concurrency": "node tests/integration/concurrency.test.js",
    "test:options": "node tests/integration/model-options.test.js",
    "test:resources": "node tests/integration/resources.test.js",
    "test:bundled": "node tests/integration/bundled-runtime.test.js",
    "test:portability": "node tests/integration/portability.test.js",
    "load:test": "node scripts/load-test.js",
    "test:tools": "node tests/integration/native-tool-calling.test.js && node tests/integration/ollama-native-tools.test.js && node tests/integration/tool-repair.test.js && node tests/integration/multi-tool-calls.test.js",
    "test:structured": "node tests/integration/structured-output.test.js",
    "test:planner": "node tests/integration/agent-plan.test.js",
    "test:guardrails": "node tests/integration/run-guardrails.test.js",
    "test:reflection": "node tests/integration/reflection-loop.test.js",
    "test:memory": "node tests/integration/memory-structured.test.js",
    "test:memory-suggestions": "node tests/integration/memory-suggestions.test.js",
    "test:memory-retrieval": "node tests/integration/memory-retrieval.test.js",
    "test:memory-history": "node tests/integration/memory-history.test.js",
    "test:memory-scopes": "node tests/integration/memory-scopes.test.js",
    "test:ui": "node tests/ui/playwright-smoke.test.js",
    "eval": "node scripts/evaluate-agenttrail.js",
    "docs:site": "node scripts/generate-docs-site.js",
    "docs:api": "node scripts/generate-api-reference.js",
    "docs:build": "node scripts/generate-api-reference.js && node scripts/generate-docs-site.js",
    "mcp": "node mcp/server.js",
    "demo:gif": "node scripts/generate-demo-gif.js",
    "demo:video": "node scripts/record-demo.js",
    "screenshots": "node scripts/generate-demo-screenshots.js",
    "release:sbom": "node scripts/generate-sbom.js",
    "release:homebrew": "node scripts/update-homebrew-formula.js",
    "release:checksums": "node scripts/generate-release-checksums.js",
    "release:verify-checksums": "node scripts/verify-checksums.js",
    "release:sign-checksums": "node scripts/sign-checksums.js",
    "release:reproducible": "node scripts/reproducible-build.js",
    "package:desktop": "node scripts/package-desktop.js",
    "package:linux": "node scripts/package-linux.js",
    "package:mac-app": "node scripts/package-mac-app.js",
    "sign:mac-app": "node scripts/sign-mac-app.js",
    "sign:windows": "node scripts/sign-windows.js",
    "benchmark": "node scripts/evaluate-agenttrail.js"
  },
  "keywords": [
