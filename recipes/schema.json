{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local Agent Recipe",
  "type": "object",
  "required": ["id", "title", "description", "prompt"],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "maxLength": 180
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "prompt": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2400
    },
    "outputSchemaId": {
      "type": "string",
      "pattern": "^[a-z0-9_-]+$"
    },
    "outputTitle": {
      "type": "string",
      "maxLength": 80
    },
    "outputDescription": {
      "type": "string",
      "maxLength": 180
    },
    "outputSchema": {
      "type": "object"
    }
  }
}
