# Copy this file to .env if you want to run with custom settings.
# The app also works without a .env file.

PORT=4173
HOST=127.0.0.1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional local OCR for scanned image attachments / /api/documents/ocr.
# Default command/args are Tesseract-compatible.
AGENTTRAIL_OCR_COMMAND=tesseract
AGENTTRAIL_OCR_ARGS={{input}} stdout -l {{language}}

# Optional local speech-to-text for /api/audio/transcribe.
# Default command/args are whisper.cpp-compatible.
AGENTTRAIL_TRANSCRIBE_COMMAND=whisper-cli
AGENTTRAIL_TRANSCRIBE_ARGS=-f {{input}} -l {{language}} --no-timestamps
AGENTTRAIL_TRANSCRIBE_MAX_BYTES=26214400

# Optional local text-to-speech for /api/audio/speak.
# Default command/args are macOS say-compatible.
AGENTTRAIL_TTS_COMMAND=say
AGENTTRAIL_TTS_ARGS=-o {{output}} {{text}}
AGENTTRAIL_TTS_FORMAT=aiff
AGENTTRAIL_TTS_MAX_TEXT_CHARS=8000

# Optional local image generation for /api/images/generate.
# Default backend/endpoint are Automatic1111/Forge-compatible; OpenAI-compatible local image servers can use AGENTTRAIL_IMAGE_BACKEND=openai-compatible.
AGENTTRAIL_IMAGE_BACKEND=automatic1111
AGENTTRAIL_IMAGE_HOST=http://127.0.0.1:7860
AGENTTRAIL_IMAGE_ENDPOINT=/sdapi/v1/txt2img
AGENTTRAIL_IMAGE_MODEL=
AGENTTRAIL_IMAGE_FORMAT=png
AGENTTRAIL_IMAGE_MAX_COUNT=4
AGENTTRAIL_IMAGE_ALLOW_REMOTE=false

# Optional OpenAI-compatible AgentTrail server mode under /v1/*.
AGENTTRAIL_V1_API_KEY=
AGENTTRAIL_V1_API_KEYS=
AGENTTRAIL_V1_REQUIRE_AUTH=false
AGENTTRAIL_V1_RATE_LIMIT_PER_MINUTE=60
AGENTTRAIL_V1_QUEUE_CONCURRENCY=2
AGENTTRAIL_V1_QUEUE_MAX=16

AGENTTRAIL_MAX_VISION_IMAGES=4
AGENTTRAIL_MAX_VISION_IMAGE_BYTES=2097152
AGENTTRAIL_MAX_ATTACHMENT_AUDIO_BYTES=8388608
AGENTTRAIL_MAX_ATTACHMENT_IMAGE_BYTES=2097152
AGENTTRAIL_MAX_ATTACHMENT_BODY_BYTES=12582912

# The agent can only read and write inside this folder.
WORKSPACE_ROOT=./workspace

# Keep this small for local models.
MAX_TOOL_ITERATIONS=4
