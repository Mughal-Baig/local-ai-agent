# Copy this file to .env if you want to run with custom settings.
# The app also works without a .env file.

PORT=4173
HOST=127.0.0.1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# Optional local OCR for scanned image attachments / /api/documents/ocr.
# Default command/args are Tesseract-compatible.
AGENTTRAIL_OCR_COMMAND=tesseract
AGENTTRAIL_OCR_ARGS={{input}} stdout -l {{language}}

# Optional local speech-to-text for /api/audio/transcribe.
# Default command/args are whisper.cpp-compatible.
AGENTTRAIL_TRANSCRIBE_COMMAND=whisper-cli
AGENTTRAIL_TRANSCRIBE_ARGS=-f {{input}} -l {{language}} --no-timestamps
AGENTTRAIL_TRANSCRIBE_MAX_BYTES=26214400

AGENTTRAIL_MAX_VISION_IMAGES=4
AGENTTRAIL_MAX_VISION_IMAGE_BYTES=2097152
AGENTTRAIL_MAX_ATTACHMENT_AUDIO_BYTES=8388608
AGENTTRAIL_MAX_ATTACHMENT_IMAGE_BYTES=2097152
AGENTTRAIL_MAX_ATTACHMENT_BODY_BYTES=12582912

# The agent can only read and write inside this folder.
WORKSPACE_ROOT=./workspace

# Keep this small for local models.
MAX_TOOL_ITERATIONS=4
