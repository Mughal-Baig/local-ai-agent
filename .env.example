# Copy this file to .env if you want to run with custom settings.
# The app also works without a .env file.

PORT=4173
HOST=127.0.0.1
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=5m
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_GPU=
OLLAMA_NUM_THREAD=

# Server-side concurrency and overload protection for /api/chat.
AGENTTRAIL_MAX_CONCURRENCY=4
AGENTTRAIL_MAX_QUEUE=64

# Security/privacy hardening. Secret redaction is on for model context, receipts,
# sessions, reports, logs, and audit artifacts. Encrypted-at-rest applies to
# managed AgentTrail artifacts when a key is configured.
AGENTTRAIL_SECRET_REDACTION=on
AGENTTRAIL_ENCRYPT_AT_REST=off
AGENTTRAIL_ENCRYPTION_KEY=
AGENTTRAIL_EGRESS_ALLOWLIST=
AGENTTRAIL_REQUIRE_EGRESS_ALLOWLIST=false
AGENTTRAIL_EGRESS_ALLOW_PRIVATE=false

# Optional Phase 6 bundled GGUF runtime. Default stays zero-dependency/off.
# Set AGENTTRAIL_MODEL_ADAPTER=bundled and install node-llama-cpp (or provide a compatible local runtime module) to use it.
AGENTTRAIL_BUNDLED_RUNTIME_MODULE=node-llama-cpp
AGENTTRAIL_GGUF_MODEL=
AGENTTRAIL_BUNDLED_MODEL_NAME=
AGENTTRAIL_BUNDLED_CONTEXT_SIZE=
# auto, metal, cuda, rocm, vulkan, or cpu. Auto prefers Metal on Apple Silicon, then CUDA/ROCm/Vulkan signals, then CPU.
AGENTTRAIL_ACCELERATION_BACKEND=auto
AGENTTRAIL_BUNDLED_GPU_LAYERS=
AGENTTRAIL_BUNDLED_THREADS=
AGENTTRAIL_BUNDLED_BATCH_SIZE=
AGENTTRAIL_BUNDLED_UBATCH_SIZE=
AGENTTRAIL_BUNDLED_PARALLEL_SEQUENCES=1
AGENTTRAIL_BUNDLED_EMBED_MODEL=
AGENTTRAIL_BUNDLED_QUANTIZATION=
AGENTTRAIL_KV_CACHE_TYPE=
AGENTTRAIL_CONTEXT_SHIFT=auto
AGENTTRAIL_CONTEXT_SHIFT_TOKENS=
AGENTTRAIL_BUNDLED_MMAP=true
AGENTTRAIL_BUNDLED_MLOCK=false
AGENTTRAIL_GPU_DEVICES=
AGENTTRAIL_TENSOR_SPLIT=
AGENTTRAIL_GPU_SPLIT_MODE=
AGENTTRAIL_MAIN_GPU=
AGENTTRAIL_RUNTIME_BENCHMARK_TOKENS=128
AGENTTRAIL_MODEL_REGISTRY_DIR=.agenttrail/model-registry
AGENTTRAIL_REGISTRY_TOKEN=
HUGGINGFACE_TOKEN=
AGENTTRAIL_CPU_SIMD=
AGENTTRAIL_CUDA_PATH=
AGENTTRAIL_ROCM_PATH=
AGENTTRAIL_VULKAN_PATH=

# Optional local OCR for scanned image attachments / /api/documents/ocr.
# Default command/args are Tesseract-compatible.
AGENTTRAIL_OCR_COMMAND=tesseract
AGENTTRAIL_OCR_ARGS={{input}} stdout -l {{language}}

# Optional local speech-to-text for /api/audio/transcribe.
# Default command/args are whisper.cpp-compatible.
AGENTTRAIL_TRANSCRIBE_COMMAND=whisper-cli
AGENTTRAIL_TRANSCRIBE_ARGS=-f {{input}} -l {{language}} --no-timestamps
AGENTTRAIL_TRANSCRIBE_MAX_BYTES=26214400

# Optional local text-to-speech for /api/audio/speak.
# Default command/args are macOS say-compatible.
AGENTTRAIL_TTS_COMMAND=say
AGENTTRAIL_TTS_ARGS=-o {{output}} {{text}}
AGENTTRAIL_TTS_FORMAT=aiff
AGENTTRAIL_TTS_MAX_TEXT_CHARS=8000

# Optional local image generation for /api/images/generate.
# Default backend/endpoint are Automatic1111/Forge-compatible; OpenAI-compatible local image servers can use AGENTTRAIL_IMAGE_BACKEND=openai-compatible.
AGENTTRAIL_IMAGE_BACKEND=automatic1111
AGENTTRAIL_IMAGE_HOST=http://127.0.0.1:7860
AGENTTRAIL_IMAGE_ENDPOINT=/sdapi/v1/txt2img
AGENTTRAIL_IMAGE_MODEL=
AGENTTRAIL_IMAGE_FORMAT=png
AGENTTRAIL_IMAGE_MAX_COUNT=4
AGENTTRAIL_IMAGE_ALLOW_REMOTE=false
AGENTTRAIL_IMAGE_ALLOWLIST=

# Optional OpenAI-compatible AgentTrail server mode under /v1/*.
AGENTTRAIL_V1_API_KEY=
AGENTTRAIL_V1_API_KEYS=
AGENTTRAIL_V1_REQUIRE_AUTH=false
AGENTTRAIL_V1_RATE_LIMIT_PER_MINUTE=60
AGENTTRAIL_V1_QUEUE_CONCURRENCY=2
AGENTTRAIL_V1_QUEUE_MAX=16

# Optional local team/enterprise mode. Team users live in team/users.json.
AGENTTRAIL_TEAM_USER=owner
AGENTTRAIL_TEAM_SYNC=off
AGENTTRAIL_TEAM_SYNC_DIR=shared-sync
AGENTTRAIL_SSO_PROVIDER=
AGENTTRAIL_SSO_ALLOWED_DOMAINS=
AGENTTRAIL_SSO_HEADER_EMAIL=x-agenttrail-sso-email

AGENTTRAIL_MAX_VISION_IMAGES=4
AGENTTRAIL_MAX_VISION_IMAGE_BYTES=2097152
AGENTTRAIL_MAX_ATTACHMENT_AUDIO_BYTES=8388608
AGENTTRAIL_MAX_ATTACHMENT_IMAGE_BYTES=2097152
AGENTTRAIL_MAX_ATTACHMENT_BODY_BYTES=12582912

# Desktop app mode, update checks, and native notifications.
AGENTTRAIL_DESKTOP=0
AGENTTRAIL_APP_MODE=browser
AGENTTRAIL_DESKTOP_NOTIFICATIONS=off
AGENTTRAIL_NOTIFY_AFTER_MS=30000
AGENTTRAIL_UPDATE_CHANNEL=stable

# The agent can only read and write inside this folder.
WORKSPACE_ROOT=./workspace

# Keep this small for local models.
MAX_TOOL_ITERATIONS=4
